@host = http://localhost:5134
# In Production replace this value with your key. Do not commit real keys.
@apiKey = local-development
# Copy the id from a POST response.
@monitorId = 00000000-0000-0000-0000-000000000000

### Readiness
GET {{host}}/health/ready

### Dashboard data
GET {{host}}/api/monitors/overview
X-Api-Key: {{apiKey}}

### Create
POST {{host}}/api/monitors
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "name": "Example",
  "url": "https://example.com",
  "checkIntervalSeconds": 60
}

### List and search
GET {{host}}/api/monitors?name=Example&limit=100&offset=0
X-Api-Key: {{apiKey}}

### Status
GET {{host}}/api/monitors/{{monitorId}}/status
X-Api-Key: {{apiKey}}

### Manual check
POST {{host}}/api/monitors/{{monitorId}}/checks
X-Api-Key: {{apiKey}}

### Check history
GET {{host}}/api/monitors/{{monitorId}}/checks?limit=50&offset=0
X-Api-Key: {{apiKey}}

### Incidents
GET {{host}}/api/monitors/{{monitorId}}/incidents?limit=50&offset=0
X-Api-Key: {{apiKey}}

### Update
PUT {{host}}/api/monitors/{{monitorId}}
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "name": "Example (renamed)",
  "url": "https://example.com/",
  "checkIntervalSeconds": 120
}

### Delete monitor and its history
DELETE {{host}}/api/monitors/{{monitorId}}
X-Api-Key: {{apiKey}}
