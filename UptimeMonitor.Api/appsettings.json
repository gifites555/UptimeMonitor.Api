{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "Monitoring": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "TimeoutSeconds": 10,
    "MaxConcurrentChecks": 4,
    "RetentionDays": 30,
    "MaxMonitors": 1000
  }
}
