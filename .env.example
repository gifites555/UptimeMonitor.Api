# Copy to .env and replace all three values with independently generated random strings.
# For MySQL passwords use hex/base64url characters (avoid ; $ # and quotes).
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
API_KEY=replace-with-a-random-api-key-at-least-32-characters
APP_PORT=8080
RETENTION_DAYS=30

